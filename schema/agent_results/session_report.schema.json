{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corticalanalysislab.org/schema/agent_results/session_report.schema.json",
  "title": "Catalog Agent Session Report",
  "type": "object",
  "required": ["contract_version", "generated_at", "summary", "counts"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "1.0" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string" },
    "counts": {
      "type": "object",
      "required": ["discovered", "existing", "ambiguous", "verified", "rejected", "included"],
      "additionalProperties": true,
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "existing": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "included": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 }
      }
    },
    "files_written": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
